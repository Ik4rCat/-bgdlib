<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.ArticlePage"
             x:DataType="vm:ArticleViewModel"
             x:Name="ArticleRoot"
             BackgroundColor="#0f0f0f"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InvertBoolConverter     x:Key="InvertBool"/>
        <conv:BookmarkIconConverter   x:Key="BookmarkIcon"/>
        <conv:BookmarkColorConverter  x:Key="BookmarkColor"/>
        <conv:CategoryColorConverter  x:Key="CatColor"/>
        <conv:CategoryBgConverter     x:Key="CatBg"/>
        <conv:CategoryIconConverter   x:Key="CatIcon"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- AppBar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
              BackgroundColor="#1a1a1a" Padding="10,12" ColumnSpacing="4">
            <Label Grid.Column="0" Text="&#xe5c4;" FontFamily="MaterialIcons"
                   FontSize="24" TextColor="#F5F5F5" VerticalOptions="Center" Margin="4,0,6,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Статья" FontFamily="OpenSansSemibold"
                   FontSize="17" TextColor="#F5F5F5" VerticalOptions="Center"/>
            <!-- Share -->
            <Label Grid.Column="2" Text="&#xe80d;" FontFamily="MaterialIcons"
                   FontSize="22" TextColor="#888888" VerticalOptions="Center" Margin="0,0,6,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShareCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <!-- Bookmark -->
            <Label Grid.Column="3" FontFamily="MaterialIcons" FontSize="22"
                   VerticalOptions="Center" Margin="0,0,8,0"
                   Text="{Binding Item.IsFavorite, Converter={StaticResource BookmarkIcon}}"
                   TextColor="{Binding Item.IsFavorite, Converter={StaticResource BookmarkColor}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Cover hero -->
                <Grid HeightRequest="200">
                    <BoxView BackgroundColor="{Binding Item.Category, Converter={StaticResource CatColor}}"
                             Opacity="0.35"/>
                    <Label Text="{Binding Item.Category, Converter={StaticResource CatIcon}}"
                           FontFamily="MaterialIcons" FontSize="80"
                           TextColor="{Binding Item.Category, Converter={StaticResource CatColor}}"
                           Opacity="0.6" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <!-- Article header -->
                <VerticalStackLayout Padding="16,14" Spacing="10">
                    <!-- Engine + Category badges -->
                    <HorizontalStackLayout Spacing="8">
                        <Border BackgroundColor="#1f1f1f" StrokeThickness="1" Stroke="#2a2a2a"
                                StrokeShape="RoundRectangle 6" Padding="9,3">
                            <Label Text="{Binding Item.Engine}" FontFamily="OpenSansSemibold"
                                   FontSize="10" TextColor="#AAAAAA"/>
                        </Border>
                        <Border BackgroundColor="{Binding Item.Category, Converter={StaticResource CatBg}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="9,3">
                            <Label Text="{Binding Item.Category}" FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="{Binding Item.Category, Converter={StaticResource CatColor}}"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Title -->
                    <Label Text="{Binding Item.Title}" FontFamily="OpenSansSemibold"
                           FontSize="22" TextColor="#FFFFFF" LineBreakMode="WordWrap"/>

                    <!-- Source + date -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding Item.Source}" FontSize="13" TextColor="#888888"/>
                        <Label Text="·" FontSize="13" TextColor="#555555"/>
                        <Label Text="{Binding Item.PublishedAt, StringFormat='{0:dd MMM yyyy}'}"
                               FontSize="13" TextColor="#555555"/>
                    </HorizontalStackLayout>

                    <!-- Reading time estimate -->
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="16"
                               TextColor="#555555" VerticalOptions="Center"/>
                        <Label Text="{Binding ReadTimeLabel}" FontSize="12"
                               TextColor="#555555" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#1f1f1f"/>

                <!-- Description / excerpt -->
                <Label Text="{Binding Item.Description}" Padding="16,14"
                       FontSize="15" TextColor="#CCCCCC" LineBreakMode="WordWrap"
                       LineHeight="1.5"/>

                <!-- Open in browser button -->
                <Border BackgroundColor="#E53935" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Margin="16,4,16,24" Padding="0">
                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenInBrowserCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe89e;" FontFamily="MaterialIcons"
                               FontSize="20" TextColor="#FFFFFF" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Читать полностью"
                               FontFamily="OpenSansSemibold" FontSize="15"
                               TextColor="#FFFFFF" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="#1f1f1f"/>

                <!-- Related articles -->
                <VerticalStackLayout Padding="16,14" Spacing="14"
                                     IsVisible="{Binding HasRelated}">
                    <Label Text="ПОХОЖИЕ СТАТЬИ" Style="{StaticResource SectionLabel}"/>
                    <CollectionView ItemsSource="{Binding RelatedItems}"
                                    SelectionMode="None" HeightRequest="300">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedItem">
                                <Border BackgroundColor="#1a1a1a" StrokeThickness="1"
                                        Stroke="#2a2a2a" StrokeShape="RoundRectangle 10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference ArticleRoot}, Path=BindingContext.OpenRelatedCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{Binding Category, Converter={StaticResource CatBg}}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                HeightRequest="48" WidthRequest="48">
                                            <Label Text="{Binding Category, Converter={StaticResource CatIcon}}"
                                                   FontFamily="MaterialIcons" FontSize="24"
                                                   TextColor="{Binding Category, Converter={StaticResource CatColor}}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold"
                                                   FontSize="13" TextColor="#F5F5F5"
                                                   MaxLines="2" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Source}" FontSize="11"
                                                   TextColor="#888888"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <BoxView HeightRequest="32" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
