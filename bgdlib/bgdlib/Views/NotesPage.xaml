<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:bgdlib.Models"
             x:Class="bgdlib.Views.NotesPage"
             BackgroundColor="#0f0f0f">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnNewNoteClicked" Order="Primary"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="#1a1a1a"
                StrokeThickness="0" 
                StrokeShape="RoundRectangle 14" Margin="16,8,16,4">
            <Grid ColumnDefinitions="Auto,*" Padding="12,0">
                <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialIcons"
                       FontSize="20" TextColor="#555555" VerticalOptions="Center"/>
                <Entry Grid.Column="1" Text="{Binding SearchQuery}"
                       Placeholder="{Binding [Notes_Search], Source={StaticResource Loc}}"
                       BackgroundColor="Transparent" TextColor="#FFFFFF"
                       PlaceholderColor="#555555" FontSize="14" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Notes}"
                        SelectionMode="Single"
                        SelectionChanged="OnNoteSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Label Text="&#xe3f4;" FontFamily="MaterialIcons"
                           FontSize="48" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label Text="{Binding [Notes_Empty], Source={StaticResource Loc}}"
                           TextColor="#555555" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{Binding [Swipe_Delete], Source={StaticResource Loc}}" BackgroundColor="#f38ba8"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Margin="16,4" Padding="14" BackgroundColor="#1a1a1a"
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 14">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Label Text="{Binding Title}" TextColor="#FFFFFF"
                                       FontSize="15" FontAttributes="Bold"/>
                                <HorizontalStackLayout Grid.Row="1" Spacing="8">
                                    <Label Text="{Binding Tags}" TextColor="#E53935" FontSize="11"/>
                                    <Label Text="·" TextColor="#333333" FontSize="11"/>
                                    <Label Text="{Binding UpdatedAt, StringFormat='{0:dd.MM.yy}'}"
                                           TextColor="#555555" FontSize="11"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
