<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.CreatePostPage"
             x:DataType="vm:CreatePostViewModel"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding [Ribbon_CreatePost], Source={StaticResource Loc}}"
                   Style="{StaticResource AppBarTitle}"
                   Margin="4,12,0,8"/>

            <Border Style="{StaticResource InputBorder}" Padding="14,4">
                <Entry Placeholder="{Binding [Post_Title], Source={StaticResource Loc}}"
                       Text="{Binding Title}"/>
            </Border>

            <Border Style="{StaticResource InputBorder}" Padding="14,8">
                <Editor Placeholder="{Binding [Post_Body], Source={StaticResource Loc}}"
                        Text="{Binding Body}" MinimumHeightRequest="140" AutoSize="TextChanges"/>
            </Border>

            <Border Style="{StaticResource InputBorder}" Padding="14,4">
                <Entry Placeholder="{Binding [Post_Tags], Source={StaticResource Loc}}"
                       Text="{Binding TagsRaw}"/>
            </Border>

            <Border Style="{StaticResource InputBorder}" Padding="14,4">
                <Picker Title="{Binding [Post_Engine], Source={StaticResource Loc}}"
                        TextColor="{StaticResource TextPrimary}" TitleColor="{StaticResource TextMuted}"
                        BackgroundColor="Transparent"
                        SelectedItem="{Binding Engine}">
                    <Picker.Items>
                        <x:String>Unity</x:String>
                        <x:String>Unreal</x:String>
                        <x:String>Godot</x:String>
                        <x:String>Other</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Border Style="{StaticResource PrimaryBtn}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" Padding="0"
                    Margin="0,8,0,0">
                <Label Text="{Binding [Post_Submit], Source={StaticResource Loc}}"
                       TextColor="{StaticResource TextPrimary}" FontSize="15" FontAttributes="Bold"
                       HorizontalOptions="Center" Padding="0,16">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SubmitCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
