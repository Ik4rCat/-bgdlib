<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             x:Name="FeedPageRoot"
             Title="BGDLib"
             BackgroundColor="#1e1e2e">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
        <conv:NotEmptyConverter x:Key="NotEmpty"/>
        <conv:IsEmptyConverter x:Key="IsEmpty"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Фильтр по движку -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="12,8">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Все'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Все" FontSize="12" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Все'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Все"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Unity" FontSize="12" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Unreal" FontSize="12" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Godot" FontSize="12" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Other'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Other" FontSize="12" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Other'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Other"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Фильтр по категории -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="12,0,12,8">
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='Все'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Все" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='Все'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="Все"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='news'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="news" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='news'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="news"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='tutorial'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="tutorial" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='tutorial'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="tutorial"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='job'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="job" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='job'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="job"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='tool'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="tool" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='tool'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="tool"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='postmortem'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="postmortem" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='postmortem'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="postmortem"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='docs'}"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="docs" FontSize="11" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='docs'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="docs"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Статус -->
        <Label Grid.Row="2" Text="{Binding StatusText}"
               TextColor="#6c7086" FontSize="12"
               Padding="12,0,12,4"
               IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}"/>

        <!-- Лента с pull-to-refresh -->
        <RefreshView Grid.Row="3"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading}"
                     RefreshColor="#89b4fa">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnArticleSelected">
                <CollectionView.EmptyView>
                    <Label Text="Нет статей. Потяните вниз для загрузки."
                           TextColor="#6c7086" HorizontalOptions="Center"
                           VerticalOptions="Center" HorizontalTextAlignment="Center"
                           Margin="24,40"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedItem">
                        <Border Margin="12,4" Padding="10" BackgroundColor="#313244"
                                StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="10">

                                <!-- Изображение или заглушка -->
                                <Grid Grid.Column="0" HeightRequest="80" WidthRequest="120"
                                      VerticalOptions="Start">
                                    <!-- Image с клиппингом через Border -->
                                    <Border IsVisible="{Binding ImageUrl, Converter={StaticResource NotEmpty}}"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            HeightRequest="80" WidthRequest="120" Padding="0">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="80" WidthRequest="120"/>
                                    </Border>
                                    <!-- Заглушка по движку -->
                                    <Border IsVisible="{Binding ImageUrl, Converter={StaticResource IsEmpty}}"
                                            BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            HeightRequest="80" WidthRequest="120">
                                        <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               FontSize="26" FontAttributes="Bold"
                                               TextColor="#1e1e2e"/>
                                    </Border>
                                </Grid>

                                <!-- Правая часть -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

                                    <!-- Бейдж: Engine • Category + кнопка избранного -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Engine}"
                                                   TextColor="#f9e2af" FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.5"/>
                                            <Label Text=" • " TextColor="#f9e2af" FontSize="10"/>
                                            <Label Text="{Binding Category}"
                                                   TextColor="#f9e2af" FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.5"/>
                                        </HorizontalStackLayout>
                                        <!-- Кнопка избранного -->
                                        <Label Grid.Column="1"
                                               IsVisible="{Binding IsFavorite, Converter={StaticResource InvertBool}}"
                                               Text="♡" FontSize="18" TextColor="#f38ba8"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="1"
                                               IsVisible="{Binding IsFavorite}"
                                               Text="♥" FontSize="18" TextColor="#f38ba8"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <!-- Заголовок -->
                                    <Label Grid.Row="1" Text="{Binding Title}"
                                           TextColor="#cdd6f4" FontSize="13" FontAttributes="Bold"
                                           MaxLines="2" LineBreakMode="WordWrap"
                                           Margin="0,4,0,0"/>

                                    <!-- Источник и дата -->
                                    <HorizontalStackLayout Grid.Row="2" Spacing="4" Margin="0,4,0,0">
                                        <Label Text="{Binding Source}" TextColor="#6c7086" FontSize="11"/>
                                        <Label Text=" • " TextColor="#6c7086" FontSize="11"/>
                                        <Label Text="{Binding PublishedAt, StringFormat='{0:dd MMM}'}"
                                               TextColor="#6c7086" FontSize="11"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Индикатор первой загрузки -->
        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsLoading}"
                           Color="#89b4fa" VerticalOptions="Center" HorizontalOptions="Center"
                           IsVisible="{Binding IsLoading}"/>

    </Grid>
</ContentPage>
