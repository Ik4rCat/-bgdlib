<?xml version="1.0" encoding="utf-8" ?>
<!--
  FeedPage.xaml — Pinterest-style 2-column card feed.
  ViewModel: FeedViewModel (unchanged — same Engine/Category filters, same Items collection).
  New converters needed: CategoryColorConverter, CategoryBgConverter, CategoryIconConverter.
  Add them to Resources/Converters and register in this page's Resources section.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             x:Name="FeedPageRoot"
             BackgroundColor="#0f0f0f"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter   x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter  x:Key="ChipText"/>
        <conv:EngineColorConverter    x:Key="EngineColor"/>
        <conv:EngineLetterConverter   x:Key="EngineLetter"/>
        <conv:NotEmptyConverter       x:Key="NotEmpty"/>
        <conv:InvertBoolConverter     x:Key="InvertBool"/>
        <conv:CategoryColorConverter  x:Key="CatColor"/>
        <conv:CategoryBgConverter     x:Key="CatBg"/>
        <conv:CategoryIconConverter   x:Key="CatIcon"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,1,*">

        <!-- ── AppBar ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
              BackgroundColor="#1a1a1a" Padding="16,13,12,13">
            <Label Grid.Column="0" Style="{StaticResource AppBarTitle}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="BGD" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="22"/>
                        <Span Text="Lib" TextColor="#E53935" FontFamily="OpenSansSemibold" FontSize="22"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <!-- Filter indicator badge -->
            <Border Grid.Column="1" BackgroundColor="#E53935"
                    StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4"
                    VerticalOptions="Center"
                    IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding StatusText}" TextColor="#FFFFFF" FontSize="11"
                       FontFamily="OpenSansSemibold"/>
            </Border>
        </Grid>

        <!-- ── Engine chips ────────────────────────────────────────── -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="#1a1a1a" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,8,12,8">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="All" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Unity" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Godot" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Unreal" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Other'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Other" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Other'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Other"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ── Category chips ──────────────────────────────────────── -->
        <ScrollView Grid.Row="2" Orientation="Horizontal"
                    BackgroundColor="#1a1a1a" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,4,12,8">
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="All" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='tutorial'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="Tutorial" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='tutorial'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="tutorial"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='news'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="News" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='news'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="news"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='tool'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="Tool" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='tool'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="tool"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='postmortem'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="Postmortem" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='postmortem'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="postmortem"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='job'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="Jobs" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='job'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="job"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedCategory, Converter={StaticResource ChipSelected}, ConverterParameter='docs'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0">
                    <Label Text="Docs" FontSize="12" Padding="12,5"
                           TextColor="{Binding SelectedCategory, Converter={StaticResource ChipText}, ConverterParameter='docs'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="docs"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="3" HeightRequest="1" BackgroundColor="#2a2a2a"/>

        <!-- ── Pinterest cards grid ─────────────────────────────────── -->
        <Grid Grid.Row="4">
            <RefreshView Command="{Binding LoadCommand}"
                         IsRefreshing="{Binding IsLoading}"
                         RefreshColor="#E53935">
            <CollectionView ItemsSource="{Binding Items}"
                            x:Name="FeedCollection"
                            Margin="8,8,8,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"
                                     HorizontalItemSpacing="8"
                                     VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedItem">
                        <Border BackgroundColor="#161616"
                                Stroke="#2a2a2a" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.OpenArticleCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="140,Auto">

                                <!-- Cover: coloured bg + category icon + engine badge + bookmark -->
                                <Grid Grid.Row="0" HeightRequest="140">
                                    <BoxView BackgroundColor="{Binding Category, Converter={StaticResource CatColor}}"
                                             Opacity="0.35"/>
                                    <!-- Big category icon centred -->
                                    <Label Text="{Binding Category, Converter={StaticResource CatIcon}}"
                                           FontFamily="MaterialIcons" FontSize="52"
                                           TextColor="{Binding Category, Converter={StaticResource CatColor}}"
                                           Opacity="0.85"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <!-- Engine badge (top-left) -->
                                    <Border BackgroundColor="#73000000" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5" Padding="7,3"
                                            HorizontalOptions="Start" VerticalOptions="Start" Margin="8">
                                        <Label Text="{Binding Engine}" FontFamily="OpenSansSemibold"
                                               FontSize="9" TextColor="#FFFFFF"/>
                                    </Border>
                                    <!-- Bookmark (top-right) -->
                                    <Label Text="&#xe87e;" FontFamily="MaterialIcons"
                                           FontSize="18" TextColor="#888888"
                                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,6,8,0"
                                           IsVisible="{Binding IsFavorite, Converter={StaticResource InvertBool}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="&#xe87d;" FontFamily="MaterialIcons"
                                           FontSize="18" TextColor="#E53935"
                                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,6,8,0"
                                           IsVisible="{Binding IsFavorite}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- Card body -->
                                <VerticalStackLayout Grid.Row="1" Padding="10,8,10,10" Spacing="6">
                                    <!-- Category badge -->
                                    <Border BackgroundColor="{Binding Category, Converter={StaticResource CatBg}}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            Padding="7,2" HorizontalOptions="Start">
                                        <Label Text="{Binding Category}" FontFamily="OpenSansSemibold"
                                               FontSize="9"
                                               TextColor="{Binding Category, Converter={StaticResource CatColor}}"/>
                                    </Border>
                                    <!-- Title -->
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold"
                                           FontSize="13" TextColor="#FFFFFF"
                                           MaxLines="3" LineBreakMode="WordWrap"/>
                                    <!-- Source · date -->
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="{Binding Source}" FontSize="10" TextColor="#888888"/>
                                        <Label Text="·" FontSize="10" TextColor="#555555"/>
                                        <Label Text="{Binding PublishedAt, StringFormat='{0:dd MMM}'}"
                                               FontSize="10" TextColor="#555555"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </RefreshView>

            <!-- Initial load spinner (no items yet) -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#E53935"
                               HorizontalOptions="Center" VerticalOptions="Center"/>

            <!-- Empty state (done loading, 0 items) -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="12" Padding="32,0">
                <Label Text="&#xe0e5;" FontFamily="MaterialIcons" FontSize="64"
                       TextColor="#2a2a2a" HorizontalOptions="Center"/>
                <Label Text="Нет новостей" TextColor="#666666"
                       FontSize="15" HorizontalOptions="Center"/>
                <Label Text="Проверьте интернет-подключение" TextColor="#444444"
                       FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Border BackgroundColor="#242424" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" Padding="24,10" HorizontalOptions="Center"
                        Margin="0,4,0,0">
                    <Label Text="Обновить" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
