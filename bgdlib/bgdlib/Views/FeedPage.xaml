<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             x:Name="FeedPageRoot"
             BackgroundColor="#0f0f0f">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
        <conv:NotEmptyConverter x:Key="NotEmpty"/>
        <conv:IsEmptyConverter x:Key="IsEmpty"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14,16,8">
            <Label Grid.Column="0" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="RSS " TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"/>
                        <Span Text="{Binding [Feed_RibbonWord], Source={StaticResource Loc}}" TextColor="#E53935" FontSize="20" FontAttributes="Bold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Border Grid.Column="1" BackgroundColor="#E53935"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,4"
                    VerticalOptions="Center"
                    IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}">
                <Label Text="{Binding StatusText}" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Engine/source filter chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,0,12,8">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="{Binding [Filter_All], Source={StaticResource Loc}}" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unity" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Godot" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unreal" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Other'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="{Binding [Cat_Other], Source={StaticResource Loc}}" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Other'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Other"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Divider -->
        <BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="#1a1a1a"/>

        <!-- News list -->
        <RefreshView Grid.Row="3"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading}"
                     RefreshColor="#E53935">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnArticleSelected">
                <CollectionView.EmptyView>
                    <Label Text="{Binding [Feed_Empty], Source={StaticResource Loc}}"
                           TextColor="#555555" HorizontalOptions="Center"
                           VerticalOptions="Center" HorizontalTextAlignment="Center"
                           Margin="24,48"/>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent"/>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedItem">
                        <Grid Padding="16,10" ColumnDefinitions="36,*,Auto" ColumnSpacing="12">

                            <!-- Source badge -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                    StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                    HeightRequest="36" WidthRequest="36" VerticalOptions="Start">
                                <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       FontSize="11" FontAttributes="Bold" TextColor="#0f0f0f"/>
                            </Border>

                            <!-- Content -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <!-- Engine · Category -->
                                <Label TextColor="#E53935" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.5">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Engine}" TextColor="#E53935"/>
                                            <Span Text=" · " TextColor="#444444"/>
                                            <Span Text="{Binding Category}" TextColor="#888888"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!-- Title -->
                                <Label Text="{Binding Title}"
                                       TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"
                                       MaxLines="2" LineBreakMode="WordWrap"/>
                                <!-- Source · Time -->
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Source}" TextColor="#555555" FontSize="11"/>
                                    <Label Text="·" TextColor="#333333" FontSize="11"/>
                                    <Label Text="{Binding PublishedAt, StringFormat='{0:dd MMM}'}"
                                           TextColor="#555555" FontSize="11"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Favorite -->
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                <Label IsVisible="{Binding IsFavorite, Converter={StaticResource InvertBool}}"
                                       Text="&#xe87e;" FontFamily="MaterialIcons"
                                       FontSize="20" TextColor="#333333">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label IsVisible="{Binding IsFavorite}"
                                       Text="&#xe87d;" FontFamily="MaterialIcons"
                                       FontSize="20" TextColor="#E53935">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference FeedPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Bottom divider -->
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3"
                                     HeightRequest="1" BackgroundColor="#1a1a1a"
                                     VerticalOptions="End" Margin="0,10,0,-10"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
