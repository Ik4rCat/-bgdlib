<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource Bg}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter  x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- AppBar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}" Padding="4,13,16,13">
            <Label Grid.Column="0" Text="&#xe5c4;" FontFamily="MaterialIcons"
                   FontSize="24" TextColor="{StaticResource TextSecondary}"
                   VerticalOptions="Center" Padding="12,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Настройки"
                   Style="{StaticResource AppBarTitle}"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="16,20,16,48">

                <!-- ── Section 1: Аккаунт ─────────────────────────────── -->
                <Label Text="АККАУНТ" FontSize="11" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextMuted}" Margin="4,0,0,8"/>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Avatar + name + email row -->
                        <HorizontalStackLayout Spacing="14" Padding="16,16,16,14">
                            <!-- Avatar circle with initials -->
                            <Border BackgroundColor="{StaticResource Accent}"
                                    StrokeShape="RoundRectangle 28"
                                    StrokeThickness="0"
                                    HeightRequest="56" WidthRequest="56">
                                <Label Text="{Binding Initials}"
                                       FontFamily="OpenSansSemibold" FontSize="20"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <!-- Name + email -->
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Username}"
                                       FontFamily="OpenSansSemibold" FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="{Binding Email}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}"/>

                        <!-- Edit profile button -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditProfileCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Редактировать профиль"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="&#xe5c8;" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,20"/>

                <!-- ── Section 2: Лента ───────────────────────────────── -->
                <Label Text="ЛЕНТА" FontSize="11" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextMuted}" Margin="4,0,0,8"/>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Auto-refresh toggle -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Автообновление ленты"
                                       FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Обновлять при открытии приложения"
                                       FontSize="12" TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AutoRefresh}"
                                    OnColor="{StaticResource Accent}"
                                    ThumbColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,0"/>

                        <!-- Refresh interval chips -->
                        <VerticalStackLayout Padding="16,14" Spacing="10">
                            <Label Text="Интервал обновления"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <!-- 5 min chip -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding RefreshInterval, Converter={StaticResource ChipSelected}, ConverterParameter='5'}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Border2}"
                                        StrokeThickness="1" Padding="0,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetIntervalCommand}" CommandParameter="5"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="5 мин"
                                           FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{Binding RefreshInterval, Converter={StaticResource ChipText}, ConverterParameter='5'}"
                                           HorizontalOptions="Center"/>
                                </Border>
                                <!-- 15 min chip -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding RefreshInterval, Converter={StaticResource ChipSelected}, ConverterParameter='15'}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Border2}"
                                        StrokeThickness="1" Padding="0,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetIntervalCommand}" CommandParameter="15"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="15 мин"
                                           FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{Binding RefreshInterval, Converter={StaticResource ChipText}, ConverterParameter='15'}"
                                           HorizontalOptions="Center"/>
                                </Border>
                                <!-- 30 min chip -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding RefreshInterval, Converter={StaticResource ChipSelected}, ConverterParameter='30'}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Border2}"
                                        StrokeThickness="1" Padding="0,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetIntervalCommand}" CommandParameter="30"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="30 мин"
                                           FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{Binding RefreshInterval, Converter={StaticResource ChipText}, ConverterParameter='30'}"
                                           HorizontalOptions="Center"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,0"/>

                        <!-- Show images toggle -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Показывать превью изображений"
                                       FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Загружать картинки в ленте"
                                       FontSize="12" TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowImages}"
                                    OnColor="{StaticResource Accent}"
                                    ThumbColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,20"/>

                <!-- ── Section 3: Уведомления ─────────────────────────── -->
                <Label Text="УВЕДОМЛЕНИЯ" FontSize="11" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextMuted}" Margin="4,0,0,8"/>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="0">
                    <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Push-уведомления"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Уведомления о новых статьях"
                                   FontSize="12" TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding PushNotifications}"
                                OnColor="{StaticResource Accent}"
                                ThumbColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,20"/>

                <!-- ── Section 4: О приложении ───────────────────────── -->
                <Label Text="О ПРИЛОЖЕНИИ" FontSize="11" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource TextMuted}" Margin="4,0,0,8"/>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Version -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Версия"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding AppVersion}"
                                   FontSize="14" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,0"/>

                        <!-- Build -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Сборка"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding BuildNumber}"
                                   FontSize="14" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,0"/>

                        <!-- Copyright -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="&#xe88e;" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" Margin="0,0,12,0"/>
                            <Label Grid.Column="1" Text="BGDLib © 2025 Crazy Animals Studio"
                                   FontSize="13" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,0"/>

                        <!-- Contact us -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ContactUsCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="&#xe0be;" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Accent}"
                                   VerticalOptions="Center" Margin="0,0,12,0"/>
                            <Label Grid.Column="1" Text="Написать нам"
                                   FontSize="15" TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="&#xe5c8;" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,20"/>

                <!-- ── Section 5: Опасная зона ───────────────────────── -->
                <Label Text="ОПАСНАЯ ЗОНА" FontSize="11" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource Accent}" Margin="4,0,0,8"/>

                <!-- Logout button — red outline -->
                <Border BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Accent}"
                        StrokeThickness="1"
                        Padding="0" Margin="0,0,0,12">
                    <Grid Padding="16,15" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe879;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="{StaticResource Accent}"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Выйти из аккаунта"
                               FontSize="15" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Accent}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Delete account button — red filled -->
                <Border BackgroundColor="{StaticResource Accent}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="0">
                    <Grid Padding="16,15" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe872;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Удалить аккаунт"
                               FontSize="15" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
