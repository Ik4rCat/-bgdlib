<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.AuthPage"
             x:DataType="vm:AuthViewModel"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:BoolToAccentConverter x:Key="BoolToAccent"/>
        <conv:BoolToAccentInvConverter x:Key="BoolToAccentInv"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- Logo -->
            <Image Source="logo.jpg"
                   HorizontalOptions="Center"
                   HeightRequest="160"
                   Aspect="AspectFit"
                   Margin="0,40,0,4"/>
            <Label Text="{Binding [Auth_Subtitle], Source={StaticResource Loc}}"
                   TextColor="{StaticResource TextMuted}" FontSize="13"
                   HorizontalOptions="Center" Margin="0,0,0,16"/>

            <!-- Login / Register toggle -->
            <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" Padding="4">
                <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="{Binding IsLogin, Converter={StaticResource BoolToAccent}}" Padding="0">
                        <Label Text="{Binding [Auth_Login], Source={StaticResource Loc}}"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"
                               Padding="0,12" FontSize="14" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToLoginCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="{Binding IsLogin, Converter={StaticResource BoolToAccentInv}}" Padding="0">
                        <Label Text="{Binding [Auth_Register], Source={StaticResource Loc}}"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"
                               Padding="0,12" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToRegisterCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>
            </Border>

            <!-- Name (register only) -->
            <Border Style="{StaticResource InputBorder}" Padding="14,4"
                    IsVisible="{Binding IsLogin, Converter={StaticResource InvertBool}}">
                <Entry Placeholder="{Binding [Auth_Name], Source={StaticResource Loc}}"
                       Text="{Binding Name}"/>
            </Border>

            <!-- Email -->
            <Border Style="{StaticResource InputBorder}" Padding="14,4">
                <Entry Placeholder="{Binding [Auth_Email], Source={StaticResource Loc}}"
                       Text="{Binding Email}" Keyboard="Email"/>
            </Border>

            <!-- Password -->
            <Border Style="{StaticResource InputBorder}" Padding="14,4">
                <Entry Placeholder="{Binding [Auth_Password], Source={StaticResource Loc}}"
                       Text="{Binding Password}" IsPassword="True"/>
            </Border>

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Accent}" FontSize="13"
                   IsVisible="{Binding HasError}" HorizontalOptions="Center"/>

            <!-- Submit button -->
            <Border Style="{StaticResource PrimaryBtn}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" Padding="0">
                <Label Text="{Binding SubmitLabel}" TextColor="{StaticResource TextPrimary}"
                       FontSize="15" FontAttributes="Bold"
                       HorizontalOptions="Center" Padding="0,16">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SubmitCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Google sign-in -->
            <Border Style="{StaticResource SecondaryBtn}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" Padding="0">
                <Grid ColumnDefinitions="Auto,*" Padding="14,0">
                    <Label Grid.Column="0" Text="G" TextColor="{StaticResource Accent}" FontSize="18" FontAttributes="Bold"
                           VerticalOptions="Center" Margin="0,0,10,0"/>
                    <Label Grid.Column="1" Text="{Binding [Auth_LoginGoogle], Source={StaticResource Loc}}"
                           TextColor="{StaticResource TextPrimary}" FontSize="15"
                           HorizontalOptions="Start" Padding="0,16">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoginGoogleCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Guest mode -->
            <Label Text="{Binding [Auth_GuestMode], Source={StaticResource Loc}}"
                   TextColor="{StaticResource TextMuted}" FontSize="13" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GuestCommand}"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
