<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             x:Class="bgdlib.Views.AuthPage"
             x:DataType="vm:AuthViewModel"
             BackgroundColor="#0f0f0f"
             Shell.NavBarIsVisible="False"
             xmlns:conv="clr-namespace:bgdlib.Converters">
    <ContentPage.Resources>
        <conv:InvertBoolConverter         x:Key="InvertBool"/>
        <conv:BoolToAccentConverter       x:Key="BoolToAccent"/>
        <conv:BoolToAccentInvConverter    x:Key="InvertBoolToAccent"/>
        <conv:BoolToWhiteConverter        x:Key="BoolToWhite"/>
        <conv:BoolToMutedConverter        x:Key="BoolToMuted"/>
        <conv:BoolToAccentBgConverter     x:Key="BoolToAccentBg"/>
        <conv:BoolToAccentBorderConverter x:Key="BoolToAccentBorder"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,32" Spacing="0">

            <!-- Logo -->
            <VerticalStackLayout Spacing="6" Margin="0,0,0,48" HorizontalOptions="Center">
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="BGD" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="38"/>
                            <Span Text="Lib" TextColor="#E53935" FontFamily="OpenSansSemibold" FontSize="38"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Gamedev-библиотека" TextColor="#555555" FontSize="14"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Tab strip: Войти / Регистрация -->
            <Grid ColumnDefinitions="*,*" BackgroundColor="#1a1a1a"
                  Margin="0,0,0,28">
                <VerticalStackLayout Grid.Column="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchToLoginCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <BoxView HeightRequest="2"
                             BackgroundColor="{Binding IsLogin, Converter={StaticResource BoolToAccent}}"
                             HorizontalOptions="Fill"/>
                    <Label Text="Войти" FontFamily="OpenSansSemibold" FontSize="15"
                           HorizontalOptions="Center" Padding="0,14" MinimumHeightRequest="48"
                           TextColor="{Binding IsLogin, Converter={StaticResource BoolToWhite}}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchToRegisterCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <BoxView HeightRequest="2"
                             BackgroundColor="{Binding IsLogin, Converter={StaticResource InvertBoolToAccent}}"
                             HorizontalOptions="Fill"/>
                    <Label Text="Регистрация" FontFamily="OpenSansSemibold" FontSize="15"
                           HorizontalOptions="Center" Padding="0,14" MinimumHeightRequest="48"
                           TextColor="{Binding IsLogin, Converter={StaticResource BoolToMuted}}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Name field (register only) -->
            <Border BackgroundColor="#1a1a1a" StrokeThickness="1" Stroke="#2a2a2a"
                    StrokeShape="RoundRectangle 10" Padding="14,4"
                    Margin="0,0,0,12"
                    IsVisible="{Binding IsLogin, Converter={StaticResource InvertBool}}">
                <Entry Text="{Binding Name}" Placeholder="Имя пользователя"
                       PlaceholderColor="#555555" TextColor="#F5F5F5"
                       BackgroundColor="Transparent" FontSize="15"/>
            </Border>

            <!-- Email -->
            <Border BackgroundColor="#1a1a1a" StrokeThickness="1" Stroke="#2a2a2a"
                    StrokeShape="RoundRectangle 10" Padding="14,4" Margin="0,0,0,12">
                <Entry Text="{Binding Email}" Placeholder="Email"
                       Keyboard="Email" PlaceholderColor="#555555"
                       TextColor="#F5F5F5" BackgroundColor="Transparent" FontSize="15"/>
            </Border>

            <!-- Password -->
            <Border BackgroundColor="#1a1a1a" StrokeThickness="1" Stroke="#2a2a2a"
                    StrokeShape="RoundRectangle 10" Padding="14,4" Margin="0,0,0,6">
                <Entry Text="{Binding Password}" Placeholder="Пароль"
                       IsPassword="True" PlaceholderColor="#555555"
                       TextColor="#F5F5F5" BackgroundColor="Transparent" FontSize="15"/>
            </Border>

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}" TextColor="#E53935" FontSize="13"
                   Margin="0,4,0,12" IsVisible="{Binding HasError}"/>

            <!-- Submit button -->
            <Border BackgroundColor="#E53935" StrokeThickness="0"
                    StrokeShape="RoundRectangle 10" Margin="0,8,0,16">
                <Grid MinimumHeightRequest="48">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SubmitCommand}"/>
                    </Grid.GestureRecognizers>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#FFFFFF"
                                       HeightRequest="22" WidthRequest="22"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" Margin="0,13"/>
                    <Label Text="{Binding SubmitLabel}" FontFamily="OpenSansSemibold"
                           FontSize="16" TextColor="#FFFFFF"
                           HorizontalOptions="Center" Padding="0,14"
                           IsVisible="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                </Grid>
            </Border>

            <!-- Divider -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10"
                  VerticalOptions="Center" Margin="0,0,0,16">
                <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#2a2a2a"
                         VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="или" TextColor="#555555" FontSize="13"/>
                <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#2a2a2a"
                         VerticalOptions="Center"/>
            </Grid>

            <!-- Google button -->
            <Border BackgroundColor="#1a1a1a" StrokeThickness="1" Stroke="#2a2a2a"
                    StrokeShape="RoundRectangle 10" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                      Padding="16,13">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginGoogleCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="G" FontFamily="OpenSansSemibold"
                           FontSize="18" TextColor="#E53935" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Войти через Google"
                           FontFamily="OpenSansSemibold" FontSize="15"
                           TextColor="#F5F5F5" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Guest -->
            <Label FontSize="14" HorizontalOptions="Center"
                   Padding="16,14" MinimumHeightRequest="48">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GuestCommand}"/>
                </Label.GestureRecognizers>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Продолжить без аккаунта " TextColor="#888888"/>
                        <Span Text="→" TextColor="#E53935" FontFamily="OpenSansSemibold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
