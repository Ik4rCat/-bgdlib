<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             x:Name="FavsPageRoot"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
        <conv:NotEmptyConverter x:Key="NotEmpty"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource Surface}" Padding="16,14,16,14">
            <Label Grid.Column="0" Text="{Binding [Tab_Saved], Source={StaticResource Loc}}"
                   Style="{StaticResource AppBarTitle}"/>
            <Border Grid.Column="1" BackgroundColor="{StaticResource Accent}"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,4"
                    VerticalOptions="Center">
                <Label Text="{Binding Items.Count, StringFormat='{0} материалов'}"
                       TextColor="{StaticResource TextPrimary}" FontSize="11" FontAttributes="Bold"/>
            </Border>
        </Grid>

        <!-- Filter chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="{StaticResource Surface}" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,0,12,10">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="{Binding [Filter_All], Source={StaticResource Loc}}" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unity" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Godot" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unreal" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Other'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="{Binding [Cat_Other], Source={StaticResource Loc}}" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Other'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Other"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}"/>

        <!-- Saved items list -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="&#xe87e;" FontFamily="MaterialIcons"
                           FontSize="44" TextColor="{StaticResource TextDisabled}" HorizontalOptions="Center"/>
                    <Label Text="{Binding [Favs_Empty], Source={StaticResource Loc}}"
                           TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FavoriteItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{Binding [Swipe_Delete], Source={StaticResource Loc}}"
                                           BackgroundColor="{StaticResource Accent}"
                                           Command="{Binding Source={x:Reference FavsPageRoot}, Path=BindingContext.RemoveCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Margin="16,4" Padding="14"
                                BackgroundColor="{StaticResource Surface}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <!-- Engine tag -->
                                <HorizontalStackLayout Grid.Row="0" Spacing="6">
                                    <Border BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                            StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="6,2">
                                        <Label Text="{Binding Engine}" TextColor="{StaticResource Bg}"
                                               FontSize="9" FontAttributes="Bold"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <!-- Title -->
                                <Label Grid.Row="1" Text="{Binding Title}"
                                       TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold"
                                       MaxLines="2" LineBreakMode="WordWrap"/>
                                <!-- Source · Date -->
                                <HorizontalStackLayout Grid.Row="2" Spacing="4">
                                    <Label Text="{Binding Source}" TextColor="{StaticResource TextMuted}" FontSize="11"/>
                                    <Label Text="·" TextColor="{StaticResource TextDisabled}" FontSize="11"/>
                                    <Label Text="{Binding SavedAt, StringFormat='{0:dd.MM.yy}'}"
                                           TextColor="{StaticResource TextMuted}" FontSize="11"/>
                                </HorizontalStackLayout>
                                <!-- Bookmark icon -->
                                <Label Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                       Text="&#xe87d;" FontFamily="MaterialIcons"
                                       FontSize="20" TextColor="{StaticResource Accent}"
                                       VerticalOptions="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
