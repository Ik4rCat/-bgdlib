<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             x:Name="FavRoot"
             BackgroundColor="#0f0f0f"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:CategoryColorConverter x:Key="CatColor"/>
        <conv:CategoryIconConverter x:Key="CatIcon"/>
        <conv:CategoryBgConverter x:Key="CatBg"/>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*">

        <!-- AppBar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#1a1a1a" Padding="10,13">
            <Label Grid.Column="0" Text="&#xe5c4;" FontFamily="MaterialIcons"
                   FontSize="24" TextColor="#F5F5F5" VerticalOptions="Center" Margin="8,0,4,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Избранное"
                   FontFamily="OpenSansSemibold" FontSize="17"
                   TextColor="#F5F5F5" VerticalOptions="Center" Margin="8,0,0,0"/>
            <Label Grid.Column="2" Text="{Binding Items.Count}"
                   TextColor="#555555" FontSize="13"
                   VerticalOptions="Center" Margin="0,0,16,0"/>
        </Grid>

        <!-- Engine filter chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="#1a1a1a" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,8">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Все" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Unity" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Godot" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0">
                    <Label Text="Unreal" FontSize="13" Padding="14,6"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="2" BackgroundColor="#2a2a2a"/>

        <!-- List / empty state -->
        <Grid Grid.Row="3">
            <!-- Empty state -->
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="14" IsVisible="{Binding IsEmpty}">
                <Label Text="&#xe87e;" FontFamily="MaterialIcons" FontSize="64"
                       TextColor="#2a2a2a" HorizontalOptions="Center"/>
                <Label Text="Пока ничего не сохранено" TextColor="#888888"
                       FontSize="15" HorizontalOptions="Center"/>
                <Label Text="Закладка на статье добавит её сюда" TextColor="#555555"
                       FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Items -->
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None"
                            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertBool}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FavoriteItem">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                  Padding="16,12">
                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding Category, Converter={StaticResource CatBg}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                        HeightRequest="52" WidthRequest="52">
                                    <Label Text="{Binding Category, Converter={StaticResource CatIcon}}"
                                           FontFamily="MaterialIcons" FontSize="26"
                                           TextColor="{Binding Category, Converter={StaticResource CatColor}}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <!-- Text -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold"
                                           FontSize="14" TextColor="#F5F5F5"
                                           MaxLines="2" LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Engine}" FontSize="11"
                                               TextColor="#E53935"/>
                                        <Label Text="·" FontSize="11" TextColor="#555555"/>
                                        <Label Text="{Binding Source}" FontSize="11"
                                               TextColor="#888888"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <!-- Remove -->
                                <Label Grid.Column="2" Text="&#xe8d5;" FontFamily="MaterialIcons"
                                       FontSize="22" TextColor="#E53935" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference FavRoot}, Path=BindingContext.RemoveCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#1a1a1a"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>
