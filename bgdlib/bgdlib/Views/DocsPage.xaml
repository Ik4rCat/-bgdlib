<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.DocsPage"
             x:DataType="vm:DocsViewModel"
             x:Name="DocsPageRoot"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,16,20,16">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding [Docs_Title], Source={StaticResource Loc}}"
                       FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                <Label Text="{Binding [Docs_Subtitle], Source={StaticResource Loc}}"
                       TextColor="{StaticResource TextMuted}" FontSize="12"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="{StaticResource Surface}" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,4,16,12">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="{Binding [Filter_All], Source={StaticResource Loc}}" FontSize="12" Padding="16,8"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineDocsCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Unity" FontSize="12" Padding="16,8"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineDocsCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Godot" FontSize="12" Padding="16,8"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineDocsCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="Unreal" FontSize="12" Padding="16,8"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineDocsCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Other'}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="0">
                    <Label Text="{Binding [Cat_Other], Source={StaticResource Loc}}" FontSize="12" Padding="16,8"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Other'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineDocsCommand}" CommandParameter="Other"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Docs}">
            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DocLink">
                    <Border Margin="16,4" Padding="0"
                            BackgroundColor="{StaticResource Surface}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference DocsPageRoot}, Path=BindingContext.OpenDocCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*">
                            <!-- Accent left bar -->
                            <BoxView Grid.Column="0" Color="{Binding AccentColor}"
                                     WidthRequest="4" CornerRadius="12,0,12,0"/>
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" Padding="14,14">
                                <Grid Grid.Row="0" ColumnDefinitions="34,*" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            BackgroundColor="{Binding AccentColor}"
                                            StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                            HeightRequest="34" WidthRequest="34">
                                        <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Bg}"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}"
                                           TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <Label Grid.Row="1" Text="{Binding Description}"
                                       TextColor="{StaticResource TextSecondary}" FontSize="12"
                                       MaxLines="2" LineBreakMode="TailTruncation"
                                       Margin="0,8,0,0"/>
                                <HorizontalStackLayout Grid.Row="2" Spacing="4" Margin="0,6,0,0">
                                    <Label Text="&#xe157;" FontFamily="MaterialIcons"
                                           FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Author}"
                                           TextColor="{StaticResource TextMuted}" FontSize="11"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
