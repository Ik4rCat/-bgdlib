<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.MainRibbonPage"
             x:DataType="vm:MainRibbonViewModel"
             x:Name="MainRibbonPageRoot"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:ChipSelectedConverter x:Key="ChipSelected"/>
        <conv:ChipTextColorConverter x:Key="ChipText"/>
        <conv:NotEmptyConverter x:Key="NotEmpty"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto"
              BackgroundColor="{StaticResource Surface}" Padding="16,14,16,14">
            <Label Grid.Column="0" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="BGD" TextColor="{StaticResource TextPrimary}" FontSize="22" FontAttributes="Bold"/>
                        <Span Text="lib" TextColor="{StaticResource Accent}" FontSize="22" FontAttributes="Bold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Grid.Column="1" Text="&#xe8b6;" FontFamily="MaterialIcons"
                   FontSize="22" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" Margin="0,0,16,0"/>
            <Label Grid.Column="2" Text="&#xe145;" FontFamily="MaterialIcons"
                   FontSize="24" TextColor="{StaticResource Accent}" VerticalOptions="Center"
                   IsVisible="{Binding IsGuest, Converter={StaticResource InvertBool}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreatePostCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Engine filter -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="{StaticResource Surface}" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6" Padding="12,0,12,8">
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='ALL'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="{Binding [Filter_All], Source={StaticResource Loc}}" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='ALL'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="ALL"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unity'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unity" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unity'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unity"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Godot'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Godot" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Godot'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Godot"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border BackgroundColor="{Binding SelectedEngine, Converter={StaticResource ChipSelected}, ConverterParameter='Unreal'}"
                        StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="0">
                    <Label Text="Unreal" FontSize="12" Padding="14,7"
                           TextColor="{Binding SelectedEngine, Converter={StaticResource ChipText}, ConverterParameter='Unreal'}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetEngineCommand}" CommandParameter="Unreal"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}"/>

        <!-- Posts list -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Posts}" RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <Label Text="{Binding [Ribbon_Empty], Source={StaticResource Loc}}"
                           TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" Margin="0,48"/>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent"/>
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CommunityPost">
                        <Grid Padding="16,12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference MainRibbonPageRoot}, Path=BindingContext.OpenPostCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <!-- Author row -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}"
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        HeightRequest="24" WidthRequest="24">
                                    <Label Text="&#xe7fd;" FontFamily="MaterialIcons"
                                           FontSize="14" TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Author.DisplayName}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12"
                                       Margin="8,0,0,0" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding CreatedAt, StringFormat='{0:dd MMM}'}"
                                       TextColor="{StaticResource TextDisabled}" FontSize="11" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Title -->
                            <Label Grid.Row="1" Text="{Binding Title}"
                                   TextColor="{StaticResource TextPrimary}" FontSize="15" FontAttributes="Bold"
                                   MaxLines="2" LineBreakMode="WordWrap"/>

                            <!-- Engine tag -->
                            <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}"
                                    StrokeShape="RoundRectangle 4" StrokeThickness="0"
                                    Padding="8,3" HorizontalOptions="Start"
                                    IsVisible="{Binding Engine, Converter={StaticResource NotEmpty}}">
                                <Label Text="{Binding Engine}" TextColor="{StaticResource Accent}"
                                       FontSize="10" FontAttributes="Bold"/>
                            </Border>

                            <!-- Vote row -->
                            <HorizontalStackLayout Grid.Row="3" Spacing="12">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="&#xe316;" FontFamily="MaterialIcons"
                                           FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference MainRibbonPageRoot}, Path=BindingContext.VoteCommand}"
                                                CommandParameter="{Binding Id}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding Upvotes}" TextColor="{StaticResource TextMuted}"
                                           FontSize="12" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="&#xe313;" FontFamily="MaterialIcons"
                                           FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Downvotes}" TextColor="{StaticResource TextMuted}"
                                           FontSize="12" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="&#xe0b9;" FontFamily="MaterialIcons"
                                           FontSize="14" TextColor="{StaticResource TextDisabled}" VerticalOptions="Center"/>
                                    <Label Text="{Binding CommentCount}" TextColor="{StaticResource TextDisabled}"
                                           FontSize="12" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Divider -->
                            <BoxView Grid.Row="3" HeightRequest="1" Color="{StaticResource Border}"
                                     VerticalOptions="End" Margin="0,30,-16,-12"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Accent}" Margin="0,8"/>

    </Grid>
</ContentPage>
