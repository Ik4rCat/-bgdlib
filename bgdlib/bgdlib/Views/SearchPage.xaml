<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             x:Name="SearchPageRoot"
             BackgroundColor="#0f0f0f">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Label Grid.Row="0" Margin="16,16,16,8">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="BGD" TextColor="#FFFFFF" FontSize="22" FontAttributes="Bold"/>
                    <Span Text="lib" TextColor="#E53935" FontSize="22" FontAttributes="Bold"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Search bar -->
        <Border Grid.Row="1" BackgroundColor="#1a1a1a" StrokeShape="RoundRectangle 12"
                StrokeThickness="0" Margin="12,0,12,8">
            <Grid ColumnDefinitions="Auto,*" Padding="12,0">
                <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialIcons"
                       FontSize="20" TextColor="#555555" VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       Placeholder="{Binding [Search_Placeholder], Source={StaticResource Loc}}"
                       Text="{Binding SearchQuery}"
                       BackgroundColor="Transparent"
                       TextColor="#FFFFFF" PlaceholderColor="#555555"
                       FontSize="14" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Categories and tags -->
        <ScrollView Grid.Row="2"
                    IsVisible="{Binding ShowResults, Converter={StaticResource InvertBool}}">
            <VerticalStackLayout Spacing="0" Padding="12,0,12,16">

                <Label Text="{Binding [Search_Categories], Source={StaticResource Loc}}"
                       TextColor="#555555" FontSize="11"
                       FontAttributes="Bold" CharacterSpacing="1" Margin="4,8,0,10"/>

                <!-- Category tiles 2-column grid -->
                <CollectionView ItemsSource="{Binding CategoryGrid}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2"
                                         HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryTile">
                            <Border BackgroundColor="{Binding Color}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="0" HeightRequest="80">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding Filter}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" Padding="14,0">
                                    <Label Grid.Column="0"
                                           Text="{Binding Icon}" FontFamily="MaterialIcons"
                                           FontSize="28" TextColor="#1a1a1a"
                                           VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#1a1a1a"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding [Search_Tags], Source={StaticResource Loc}}"
                       TextColor="#555555" FontSize="11"
                       FontAttributes="Bold" CharacterSpacing="1" Margin="4,16,0,10"/>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding PopularTags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="#1a1a1a" StrokeShape="RoundRectangle 20"
                                        StrokeThickness="0" Padding="14,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectTagCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}" TextColor="#CCCCCC" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Results -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Results}"
                        IsVisible="{Binding ShowResults}">
            <CollectionView.EmptyView>
                <Label Text="{Binding [Search_NoResults], Source={StaticResource Loc}}"
                       TextColor="#555555"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FeedItem">
                    <Border Margin="12,4" Padding="12" BackgroundColor="#1a1a1a"
                            StrokeShape="RoundRectangle 12" StrokeThickness="0">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    HeightRequest="44" WidthRequest="44"
                                    VerticalOptions="Start">
                                <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       FontSize="13" FontAttributes="Bold" TextColor="#1a1a1a"/>
                            </Border>
                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Text="{Binding Title}"
                                       TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold"
                                       MaxLines="2" LineBreakMode="WordWrap"/>
                                <Label Grid.Row="1" Text="{Binding Description}"
                                       TextColor="#9E9E9E" FontSize="11"
                                       MaxLines="2" LineBreakMode="TailTruncation" Margin="0,4,0,0"/>
                                <HorizontalStackLayout Grid.Row="2" Spacing="6" Margin="0,4,0,0">
                                    <Label Text="{Binding Source}" TextColor="#E53935" FontSize="10"/>
                                    <Label Text="•" TextColor="#555555" FontSize="10"/>
                                    <Label Text="{Binding Engine}" TextColor="#9E9E9E" FontSize="10"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
