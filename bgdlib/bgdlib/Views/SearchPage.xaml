<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             x:Name="SearchPageRoot"
             BackgroundColor="#0f0f0f">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*">

        <!-- Header -->
        <Label Grid.Row="0" Text="Поиск"
               TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"
               Margin="16,14,16,8"/>

        <!-- Search bar -->
        <Border Grid.Row="1" BackgroundColor="#1a1a1a"
                StrokeShape="RoundRectangle 8" StrokeThickness="0"
                Margin="12,0,12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0">
                <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialIcons"
                       FontSize="20" TextColor="#555555" VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       Placeholder="{Binding [Search_Placeholder], Source={StaticResource Loc}}"
                       Text="{Binding SearchQuery}"
                       BackgroundColor="Transparent"
                       TextColor="#FFFFFF" PlaceholderColor="#555555"
                       FontSize="14" Margin="8,0,0,0"/>
                <Label Grid.Column="2" Text="&#xe5cd;" FontFamily="MaterialIcons"
                       FontSize="18" TextColor="#555555" VerticalOptions="Center"
                       IsVisible="{Binding ShowResults}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="#1a1a1a"/>

        <!-- Default: categories + tags -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding ShowResults, Converter={StaticResource InvertBool}}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,16">

                <!-- Направления section header -->
                <Label Text="НАПРАВЛЕНИЯ"
                       TextColor="#555555" FontSize="10"
                       FontAttributes="Bold" CharacterSpacing="1.5"
                       Margin="16,16,16,4"/>

                <!-- Directions list -->
                <CollectionView ItemsSource="{Binding PopularTags}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectTagCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding .}"
                                       TextColor="#FFFFFF" FontSize="15"/>
                                <Label Grid.Column="1" Text="&#xe5c8;" FontFamily="MaterialIcons"
                                       FontSize="18" TextColor="#333333" VerticalOptions="Center"/>
                                <BoxView Grid.Column="0" Grid.ColumnSpan="2"
                                         HeightRequest="1" BackgroundColor="#1a1a1a"
                                         VerticalOptions="End" Margin="0,10,-16,-12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Жанры section header -->
                <Label Text="ЖАНРЫ"
                       TextColor="#555555" FontSize="10"
                       FontAttributes="Bold" CharacterSpacing="1.5"
                       Margin="16,20,16,10"/>

                <!-- Category 2-column grid -->
                <CollectionView ItemsSource="{Binding CategoryGrid}" Margin="12,0">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3"
                                         HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryTile">
                            <Border BackgroundColor="#1a1a1a"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0" Padding="0" HeightRequest="72">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding Filter}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                    <Label Text="{Binding Icon}" FontFamily="MaterialIcons"
                                           FontSize="22" TextColor="{Binding Color}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="12" TextColor="#FFFFFF"
                                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Results -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Results}"
                        IsVisible="{Binding ShowResults}">
            <CollectionView.EmptyView>
                <Label Text="{Binding [Search_NoResults], Source={StaticResource Loc}}"
                       TextColor="#555555"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,48"/>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FeedItem">
                    <Grid Padding="16,10" ColumnDefinitions="36,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                HeightRequest="36" WidthRequest="36" VerticalOptions="Start">
                            <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   FontSize="11" FontAttributes="Bold" TextColor="#0f0f0f"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Title}"
                                   TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"
                                   MaxLines="2" LineBreakMode="WordWrap"/>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding Source}" TextColor="#E53935" FontSize="11"/>
                                <Label Text="·" TextColor="#333333" FontSize="11"/>
                                <Label Text="{Binding Engine}" TextColor="#555555" FontSize="11"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="0" Grid.ColumnSpan="2"
                                 HeightRequest="1" BackgroundColor="#1a1a1a"
                                 VerticalOptions="End" Margin="0,10,-16,-10"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
