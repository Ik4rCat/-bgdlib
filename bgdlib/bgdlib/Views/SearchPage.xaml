<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             xmlns:conv="clr-namespace:bgdlib.Converters"
             x:Class="bgdlib.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             x:Name="SearchPageRoot"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:EngineColorConverter x:Key="EngineColor"/>
        <conv:EngineLetterConverter x:Key="EngineLetter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,1,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,14,16,14">
            <Label Text="{Binding [Tab_Search], Source={StaticResource Loc}}"
                   Style="{StaticResource AppBarTitle}"/>
        </Grid>

        <!-- Search bar -->
        <Border Grid.Row="1" Style="{StaticResource InputBorder}"
                Margin="12,0,12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0">
                <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialIcons"
                       FontSize="20" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       Placeholder="{Binding [Search_Placeholder], Source={StaticResource Loc}}"
                       Text="{Binding SearchQuery}"
                       FontSize="14" Margin="8,0,0,0"/>
                <Label Grid.Column="2" Text="&#xe5cd;" FontFamily="MaterialIcons"
                       FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"
                       IsVisible="{Binding ShowResults}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}"/>

        <!-- Default: categories + tags -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding ShowResults, Converter={StaticResource InvertBool}}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,16">

                <Label Text="{Binding [Search_Tags], Source={StaticResource Loc}}"
                       Style="{StaticResource SectionLabel}"
                       Margin="16,16,16,4"/>

                <CollectionView ItemsSource="{Binding PopularTags}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectTagCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding .}"
                                       TextColor="{StaticResource TextPrimary}" FontSize="15"/>
                                <Label Grid.Column="1" Text="&#xe5c8;" FontFamily="MaterialIcons"
                                       FontSize="18" TextColor="{StaticResource TextDisabled}" VerticalOptions="Center"/>
                                <BoxView Grid.Column="0" Grid.ColumnSpan="2"
                                         HeightRequest="1" Color="{StaticResource Border}"
                                         VerticalOptions="End" Margin="0,10,-16,-12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding [Search_Categories], Source={StaticResource Loc}}"
                       Style="{StaticResource SectionLabel}"
                       Margin="16,20,16,10"/>

                <CollectionView ItemsSource="{Binding CategoryGrid}" Margin="12,0">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3"
                                         HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryTile">
                            <Border BackgroundColor="{StaticResource Surface}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1" Padding="0" HeightRequest="72">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference SearchPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding Filter}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                                    <Label Text="{Binding Icon}" FontFamily="MaterialIcons"
                                           FontSize="22" TextColor="{Binding Color}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding Name}"
                                           FontSize="12" TextColor="{StaticResource TextPrimary}"
                                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Results -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Results}"
                        IsVisible="{Binding ShowResults}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="&#xe8b6;" FontFamily="MaterialIcons"
                           FontSize="44" TextColor="{StaticResource TextDisabled}" HorizontalOptions="Center"/>
                    <Label Text="{Binding [Search_NoResults], Source={StaticResource Loc}}"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" Margin="0,0,0,48"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent"/>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FeedItem">
                    <Grid Padding="16,10" ColumnDefinitions="36,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{Binding Engine, Converter={StaticResource EngineColor}}"
                                StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                HeightRequest="36" WidthRequest="36" VerticalOptions="Start">
                            <Label Text="{Binding Engine, Converter={StaticResource EngineLetter}}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Bg}"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Title}"
                                   TextColor="{StaticResource TextPrimary}" FontSize="14" FontAttributes="Bold"
                                   MaxLines="2" LineBreakMode="WordWrap"/>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding Source}" TextColor="{StaticResource Accent}" FontSize="11"/>
                                <Label Text="·" TextColor="{StaticResource TextDisabled}" FontSize="11"/>
                                <Label Text="{Binding Engine}" TextColor="{StaticResource TextMuted}" FontSize="11"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="0" Grid.ColumnSpan="2"
                                 HeightRequest="1" Color="{StaticResource Border}"
                                 VerticalOptions="End" Margin="0,10,-16,-10"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
