<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             x:Class="bgdlib.Views.PostDetailPage"
             x:DataType="vm:PostDetailViewModel"
             x:Name="PostDetailRoot"
             BackgroundColor="#0f0f0f">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="12">

                <!-- Title -->
                <Label Text="{Binding Post.Title}"
                       TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"/>

                <!-- Author / date -->
                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#242424" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            Padding="6,3">
                        <Label Text="{Binding Post.Author.DisplayName}"
                               TextColor="#888888" FontSize="12"/>
                    </Border>
                    <Label Text="{Binding Post.CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                           TextColor="#555555" FontSize="12" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Vote row -->
                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#242424" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xe316;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="#a6e3a1" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding VoteUpCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding Post.Upvotes}"
                                   TextColor="#FFFFFF" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="#242424" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xe313;" FontFamily="MaterialIcons"
                                   FontSize="18" TextColor="#f38ba8" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding VoteDownCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="{Binding Post.Downvotes}"
                                   TextColor="#FFFFFF" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Body -->
                <Label Text="{Binding Post.Body}"
                       TextColor="#bac2de" FontSize="14" LineBreakMode="WordWrap"
                       Margin="0,4,0,0"/>

                <!-- Divider -->
                <BoxView HeightRequest="1" BackgroundColor="#1a1a1a" Margin="0,8"/>

                <!-- Comments header -->
                <Label Text="{Binding [Post_Comments], Source={StaticResource Loc}}"
                       TextColor="#555555" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2"/>

                <!-- Comments list -->
                <CollectionView ItemsSource="{Binding Comments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PostComment">
                            <VerticalStackLayout Padding="0,8" Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Author.DisplayName}"
                                           TextColor="#E53935" FontSize="12" FontAttributes="Bold"/>
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM}'}"
                                           TextColor="#555555" FontSize="11" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Body}" TextColor="#bac2de" FontSize="13"/>
                                <BoxView HeightRequest="1" BackgroundColor="#1a1a1a" Margin="0,4"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add comment -->
        <Border Grid.Row="1" BackgroundColor="#181825"
                Stroke="#313244" 
                StrokeShape="RoundRectangle 0" Padding="12,10"
                IsVisible="{Binding CanComment}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#1a1a1a"
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 12" Padding="12,4">
                    <Entry Text="{Binding NewComment}"
                           Placeholder="{Binding [Post_AddComment], Source={StaticResource Loc}}"
                           PlaceholderColor="#555555" TextColor="#FFFFFF"
                           BackgroundColor="Transparent"/>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#E53935"
                        StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,10">
                    <Label Text="&#xe163;" FontFamily="MaterialIcons"
                           FontSize="20" TextColor="#1e1e2e" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendCommentCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
