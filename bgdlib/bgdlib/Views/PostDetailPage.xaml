<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:bgdlib.ViewModels"
             xmlns:models="clr-namespace:bgdlib.Models"
             x:Class="bgdlib.Views.PostDetailPage"
             x:DataType="vm:PostDetailViewModel"
             x:Name="PostDetailRoot"
             BackgroundColor="#0f0f0f">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Title -->
                <Label Text="{Binding Post.Title}" TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"/>

                <!-- Author / date -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Post.Author.DisplayName}" TextColor="#9E9E9E" FontSize="12"/>
                    <Label Text="•" TextColor="#555555" FontSize="12"/>
                    <Label Text="{Binding Post.CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                           TextColor="#555555" FontSize="12"/>
                </HorizontalStackLayout>

                <!-- Vote row -->
                <HorizontalStackLayout Spacing="12">
                    <Label Text="&#xe316;" FontFamily="MaterialIcons" FontSize="22" TextColor="#555555">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoteUpCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding Post.Upvotes}" TextColor="#FFFFFF" VerticalOptions="Center"/>
                    <Label Text="&#xe313;" FontFamily="MaterialIcons" FontSize="22" TextColor="#555555">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoteDownCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding Post.Downvotes}" TextColor="#FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Body -->
                <Label Text="{Binding Post.Body}" TextColor="#CCCCCC" FontSize="14" LineBreakMode="WordWrap"/>

                <!-- Divider -->
                <BoxView HeightRequest="1" BackgroundColor="#242424" Margin="0,8"/>

                <!-- Comments header -->
                <Label Text="{Binding [Post_Comments], Source={StaticResource Loc}}"
                       TextColor="#555555" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>

                <!-- Comments list -->
                <CollectionView ItemsSource="{Binding Comments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PostComment">
                            <VerticalStackLayout Padding="0,8" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Author.DisplayName}" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM}'}" TextColor="#555555" FontSize="11"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Body}" TextColor="#CCCCCC" FontSize="13"/>
                                <BoxView HeightRequest="1" BackgroundColor="#1a1a1a" Margin="0,4"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add comment -->
        <Border Grid.Row="1" BackgroundColor="#1a1a1a" StrokeThickness="0" Padding="12,8"
                IsVisible="{Binding CanComment}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding NewComment}"
                       Placeholder="{Binding [Post_AddComment], Source={StaticResource Loc}}"
                       PlaceholderColor="#555555" TextColor="#FFFFFF" BackgroundColor="Transparent"/>
                <Label Grid.Column="1" Text="&#xe163;" FontFamily="MaterialIcons"
                       FontSize="24" TextColor="#E53935" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendCommentCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
