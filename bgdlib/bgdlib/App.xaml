<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:bgdlib"
             xmlns:converters="clr-namespace:bgdlib.Converters"
             xmlns:svc="clr-namespace:bgdlib.Services"
             x:Class="bgdlib.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <converters:NotEmptyConverter x:Key="NotEmptyConverter"/>
            <converters:BoolToAccentConverter x:Key="BoolToAccent"/>
            <converters:BoolToAccentInvConverter x:Key="BoolToAccentInv"/>
            <svc:LocalizationService x:Key="Loc"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
