<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="bgdlib.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:bgdlib.Views"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#1e1e2e"/>
                <Setter Property="Shell.TabBarForegroundColor" Value="#89b4fa"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="#45475a"/>
                <Setter Property="Shell.TabBarTitleColor" Value="#cdd6f4"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent Title="Лента"      ContentTemplate="{DataTemplate views:FeedPage}"      Route="FeedPage"/>
        <ShellContent Title="Поиск"      ContentTemplate="{DataTemplate views:SearchPage}"    Route="SearchPage"/>
        <ShellContent Title="Сохранено"  ContentTemplate="{DataTemplate views:FavoritesPage}" Route="FavoritesPage"/>
        <ShellContent Title="Вакансии"   ContentTemplate="{DataTemplate views:JobsPage}"      Route="JobsPage"/>
        <ShellContent Title="Доки"       ContentTemplate="{DataTemplate views:DocsPage}"      Route="DocsPage"/>
        <ShellContent Title="Заметки"    ContentTemplate="{DataTemplate views:NotesPage}"     Route="NotesPage"/>
        <ShellContent Title="Профиль"    ContentTemplate="{DataTemplate views:ProfilePage}"   Route="ProfilePage"/>
    </TabBar>

</Shell>
