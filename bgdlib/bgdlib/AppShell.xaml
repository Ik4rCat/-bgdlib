<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="bgdlib.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:bgdlib.Views"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}"/>
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Accent}"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextMuted}"/>
                <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Accent}"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent x:Name="TabRss"
                      Title="Новости"
                      ContentTemplate="{DataTemplate views:FeedPage}"
                      Route="FeedPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe0e5;" Size="24"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent x:Name="TabMain"
                      Title="Лента"
                      ContentTemplate="{DataTemplate views:MainRibbonPage}"
                      Route="MainRibbonPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe88a;" Size="24"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent x:Name="TabSearch"
                      Title="Поиск"
                      ContentTemplate="{DataTemplate views:SearchPage}"
                      Route="SearchPage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Size="24"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent x:Name="TabProfile"
                      Title="Профиль"
                      ContentTemplate="{DataTemplate views:ProfilePage}"
                      Route="ProfilePage">
            <ShellContent.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe7fd;" Size="24"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
